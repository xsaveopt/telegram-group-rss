# HTTP listen address
ADDR=:8080

# Poll interval per channel (Go duration: 30s, 2m, 1h ...)
INTERVAL=5m

# Max messages kept in memory per channel
MAX_MESSAGES=100

# Comma/space/semicolon separated list of public channels to preload at startup
CHANNELS=durov,telegram

# Mount the app under a subpath for reverse-proxying (no trailing slash). Empty = root.
BASE_PATH=/tg
